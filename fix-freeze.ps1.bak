#  4) TrayIconManager.cs
# ==========================================================
Write-Host "`n[4/6] TrayIconManager.cs..." -ForegroundColor Yellow

Write-FileForce "Flavirus.UI/TrayIconManager.cs" @'
using System.Windows;
using System.Windows.Controls;
using Flavirus.UI.Views;
using Hardcodet.Wpf.TaskbarNotification;

namespace Flavirus.UI;

public class TrayIconManager
{
    private TaskbarIcon? _icon;
    private MenuItem? _toggleItem;

    public void Initialize()
    {
        _icon = new TaskbarIcon
        {
            Icon = System.Drawing.SystemIcons.Shield,
            ToolTipText = "FLAVIRUS · Protegido"
        };

        var menu = new ContextMenu();
        var open = new MenuItem { Header = "Abrir painel Flavirus" };
        open.Click += (_, _) => ShowMainWindow();
        _toggleItem = new MenuItem { Header = "Desligar proteção", IsCheckable = true, IsChecked = true };
        _toggleItem.Click += (_, _) => ToggleProtection();
        var scan = new MenuItem { Header = "Varredura rápida" };
        scan.Click += async (_, _) => await RunQuickScan();
        var exit = new MenuItem { Header = "Sair" };
        exit.Click += (_, _) => Application.Current.Shutdown();

        menu.Items.Add(open);
        menu.Items.Add(new Separator());
        menu.Items.Add(_toggleItem);
        menu.Items.Add(scan);
        menu.Items.Add(new Separator());
        menu.Items.Add(exit);
        _icon.ContextMenu = menu;
        _icon.TrayMouseDoubleClick += (_, _) => ShowMainWindow();
    }

    private void ToggleProtection()
    {
        App.Config.ProtectionEnabled = !App.Config.ProtectionEnabled;
        if (_toggleItem != null)
        {
            _toggleItem.IsChecked = App.Config.ProtectionEnabled;
            _toggleItem.Header = App.Config.ProtectionEnabled ? "Desligar proteção" : "Ligar proteção";
        }
        if (_icon != null)
        {
            _icon.ToolTipText = App.Config.ProtectionEnabled
                ? "FLAVIRUS · Protegido" : "FLAVIRUS · DESLIGADO";
        }
    }

    private async Task RunQuickScan()
    {
        var downloads = Path.Combine(
            Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "Downloads");
        var r = await App.Engine.ScanDirectoryAsync(downloads);
        _icon?.ShowBalloonTip("FLAVIRUS",
            $"Scan: {r.FilesScanned} arquivos · {r.ThreatsFound} ameaças.",
            BalloonIcon.Info);
    }

    public void ShowMainWindow()
    {
        try
        {
            foreach (Window w in Application.Current.Windows)
            {
                if (w is MainWindow)
                {
                    if (w.WindowState == WindowState.Minimized)
                        w.WindowState = WindowState.Normal;
                    w.Show();
                    w.Activate();
                    w.Topmost = true;
                    w.Topmost = false;
                    w.Focus();
                    return;
                }
            }
            var win = new MainWindow();
            win.Show();
            win.Activate();
        }
        catch (Exception ex)
        {
            MessageBox.Show(
                $"Falha ao abrir painel:\n\n{ex.Message}\n\n{ex.InnerException?.Message}",
                "Flavirus", MessageBoxButton.OK, MessageBoxImage.Error);
        }
    }
}
'@

# ==========================================================
#  5) App.xaml.cs
# ==========================================================
Write-Host "`n[5/6] App.xaml.cs..." -ForegroundColor Yellow

Write-FileForce "Flavirus.UI/App.xaml.cs" @'
using System.IO;
using System.Windows;
using Flavirus.Core.Behavior;
using Flavirus.Core.Engine;
using Flavirus.Core.Models;
using Flavirus.Core.Quarantine;
using Flavirus.Core.Ransomware;
using Flavirus.Core.Web;

namespace Flavirus.UI;

public partial class App : Application
{
    public static FlavirusConfig Config { get; } = new();
    public static ScanEngine Engine { get; private set; } = null!;
    public static WebShield Web { get; private set; } = null!;
    public static BehaviorShield Behavior { get; private set; } = null!;
    public static RansomwareShield? Ransomware { get; private set; }
    public static QuarantineManager Quarantine { get; private set; } = null!;

    protected override void OnStartup(StartupEventArgs e)
    {
        base.OnStartup(e);
        DispatcherUnhandledException += (_, ex) =>
        {
            try { File.WriteAllText(Path.Combine(AppContext.BaseDirectory, "crash.log"), ex.Exception.ToString()); } catch { }
            MessageBox.Show($"Erro: {ex.Exception.Message}", "Flavirus",
                MessageBoxButton.OK, MessageBoxImage.Error);
            ex.Handled = true;
        };
        try
        {
            var baseDir = AppContext.BaseDirectory;
            var db = new SignatureDatabase(Path.Combine(baseDir, Config.SignatureDbPath));
            var yara = new YaraEngine();
            var rulesPath = Path.Combine(baseDir, "Data", "rules.yaml");
            if (!File.Exists(rulesPath)) rulesPath = Path.Combine(baseDir, "rules.yaml");
            if (File.Exists(rulesPath)) yara.LoadRules(RuleLoader.LoadFromYaml(rulesPath));
            Engine = new ScanEngine(db, yara);
            Web = new WebShield();
            Web.LoadFromList(new[] { "malware-test.com", "phishing-example.org" });
            Behavior = new BehaviorShield();
            Quarantine = new QuarantineManager(Path.Combine(baseDir, Config.QuarantinePath));
            Task.Run(() =>
            {
                try
                {
                    Ransomware = new RansomwareShield();
                    var dirs = new[] {
                        Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments),
                        Environment.GetFolderPath(Environment.SpecialFolder.Desktop)
                    }.Where(Directory.Exists).ToArray();
                    if (dirs.Length > 0) Ransomware.Start(dirs);
                }
                catch { }
            });
            new TrayIconManager().Initialize();
            var mainWin = new Views.MainWindow();
            mainWin.Show();
        }
        catch (Exception ex)
        {
            try { File.WriteAllText(Path.Combine(AppContext.BaseDirectory, "crash.log"), ex.ToString()); } catch { }
            MessageBox.Show(
                $"Flavirus falhou ao iniciar:\n\n{ex.Message}\n\nVeja crash.log na pasta do app.",
                "Flavirus", MessageBoxButton.OK, MessageBoxImage.Error);
        }
    }
}
'@

# ==========================================================
#  6) BUILD (usa o nome do .sln/.slnx detectado)
# ==========================================================
Write-Host "`n[6/6] Limpando bin/obj e buildando $slnFile..." -ForegroundColor Yellow

Get-ChildItem -Path $root -Include bin,obj -Recurse -Directory -ErrorAction SilentlyContinue |
    Remove-Item -Recurse -Force -ErrorAction SilentlyContinue

dotnet build $slnFile -c Debug

if ($LASTEXITCODE -ne 0) {
    Write-Host "`n❌ BUILD FALHOU" -ForegroundColor Red
    exit 1
}

Write-Host "`n============================================" -ForegroundColor Green
Write-Host " ✅ FIX FINAL APLICADO" -ForegroundColor Green
Write-Host "============================================" -ForegroundColor Green
Write-Host ""
Write-Host "Rodar o app:" -ForegroundColor Yellow
Write-Host "  dotnet run --project Flavirus.UI" -ForegroundColor White