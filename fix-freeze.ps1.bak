# ============================================================
#  FLAVIRUS - FIX FINAL (compativel com .sln E .slnx)
# ============================================================
$ErrorActionPreference = "Stop"
$root = Get-Location

# Detecta o arquivo de solucao (.sln ou .slnx)
$sln = Get-ChildItem -Path $root -Include "*.sln","*.slnx" -File -ErrorAction SilentlyContinue |
       Select-Object -First 1

if (-not $sln) {
    Write-Host "ERRO: nenhum arquivo .sln ou .slnx encontrado na pasta atual." -ForegroundColor Red
    Write-Host "Pasta atual: $root" -ForegroundColor Yellow
    Write-Host "Certifique-se de estar na raiz do projeto Flavirus." -ForegroundColor Yellow
    exit 1
}

$slnFile = $sln.Name
Write-Host "`n=== FLAVIRUS: FIX FINAL ===" -ForegroundColor Cyan
Write-Host "Solucao detectada: $slnFile" -ForegroundColor Green

function Write-FileForce {
    param([string]$Path, [string]$Content)
    $full = Join-Path $root $Path
    $dir  = Split-Path $full -Parent
    if (-not (Test-Path $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }
    Set-Content -Path $full -Value $Content -Encoding UTF8
    Write-Host "  [ok] $Path" -ForegroundColor Green
}

