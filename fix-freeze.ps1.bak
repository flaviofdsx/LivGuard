Write-Host "`n[3/6] MainWindow.xaml.cs..." -ForegroundColor Yellow

Write-FileForce "Flavirus.UI/Views/MainWindow.xaml.cs" @'
using System.Windows;
using System.Windows.Threading;

namespace Flavirus.UI.Views;

public partial class MainWindow : Window
{
    private readonly DispatcherTimer _timer;
    private readonly DateTime _start = DateTime.UtcNow;

    public MainWindow()
    {
        try
        {
            InitializeComponent();
        }
        catch (Exception ex)
        {
            MessageBox.Show(
                $"Erro ao carregar XAML:\n\n{ex.Message}\n\n{ex.InnerException?.Message}",
                "Flavirus - Erro XAML", MessageBoxButton.OK, MessageBoxImage.Error);
            throw;
        }

        _timer = new DispatcherTimer { Interval = TimeSpan.FromSeconds(1) };
        _timer.Tick += (_, _) => UpdateClock();
        _timer.Start();
        UpdateClock();
    }

    private void UpdateClock()
    {
        try
        {
            ClockText.Text = DateTime.Now.ToString("HH:mm:ss");
            var up = DateTime.UtcNow - _start;
            UptimeText.Text = $"{(int)up.TotalHours:D2}:{up.Minutes:D2}:{up.Seconds:D2}";
            ConnectionStatus.Text = App.Config.ProtectionEnabled ? "◉ ONLINE" : "◯ PAUSADO";
            ConnectionStatus.Foreground = App.Config.ProtectionEnabled
                ? (System.Windows.Media.Brush)FindResource("AccentGreen")
                : (System.Windows.Media.Brush)FindResource("AlertRed");
            StatusTitle.Text = App.Config.ProtectionEnabled ? "SISTEMA PROTEGIDO" : "PROTEÇÃO DESLIGADA";
            StatusTitle.Foreground = App.Config.ProtectionEnabled
                ? (System.Windows.Media.Brush)FindResource("AccentGreen")
                : (System.Windows.Media.Brush)FindResource("AlertRed");
            StatusSubtitle.Text = App.Config.ProtectionEnabled
                ? "Todos os shields ativos · Definições atualizadas"
                : "Nenhum shield está protegendo seu sistema";
        }
        catch { }
    }

    private void ToggleMaster_Changed(object sender, RoutedEventArgs e)
    {
        App.Config.ProtectionEnabled = ToggleMaster.IsChecked == true;
        UpdateClock();
    }

    private void Minimize_Click(object sender, RoutedEventArgs e) => WindowState = WindowState.Minimized;
    private void Close_Click(object sender, RoutedEventArgs e) => Hide();
}
'@

